# Copy to .env for local development: cp .env.example .env
# On the server, deploy.sh generates .env with random secrets instead.
DOMAIN=localhost
PROTOCOL=http
HMR_PORT=80
APP_BASE_URL=http://localhost

VITE_API_URL=http://localhost/api
VITE_KEYCLOAK_URL=http://localhost/auth
VITE_KEYCLOAK_REALM=atlas
VITE_KEYCLOAK_CLIENT_ID=atlas-frontend
VITE_CARTO_API_KEY=<ask-a-teammate>

KEYCLOAK_ISSUER=http://localhost/auth/realms/atlas
CORS_ORIGINS=http://localhost,https://localhost,http://localhost:5173

INTERNAL_KEYCLOAK_URL=http://keycloak:8080/auth
REDIS_URL=redis://redis:6379
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/atlas

# Local-only defaults. Never reuse these on a public server.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=atlas
KEYCLOAK_CLIENT_ID=atlas-backend
KEYCLOAK_CLIENT_SECRET=secret
KEYCLOAK_FRONT_END_CLIENT_ID=atlas-frontend

POSTGRES_DB=atlas
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak

CADDY_SITE=http://localhost
ACME_EMAIL=admin@example.com
