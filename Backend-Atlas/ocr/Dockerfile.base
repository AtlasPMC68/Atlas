# Base Docker Image for OCR Processing Workers
FROM python:3.12-slim

ARG UID=1000
ENV UID=${UID}
RUN useradd -m -u ${UID} appuser

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Install shared heavy dependencies to leverage Docker layer caching
RUN pip install --no-cache-dir --extra-index-url https://download.pytorch.org/whl/cpu torch torchvision

RUN pip install --no-cache-dir \
    Pillow \
    numpy \
    accelerate \
    celery \
    redis \
    scikit-image

ENV HF_HOME=/app/models
RUN mkdir -p /app/models/hub /app/models /data && \
    chown -R appuser:appuser /app/models /data && \
    chmod -R 777 /data
